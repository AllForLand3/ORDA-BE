# .env로 복사한 뒤 DB 접속 정보를 설정하세요. 실제 값이 담긴 .env는 커밋하지 마세요.
APP_HOST_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:55432/gwanak_dev
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 로컬 JWT 키는 각자 생성해 아래에 붙여넣으세요. 키 변경 시 기존 토큰은 무효화됩니다.
# PowerShell에서 아래 두 줄 실행 → 키가 클립보드에 복사됩니다.
# $jwtBytes = New-Object byte[] 32; $jwtRandom = [Security.Cryptography.RandomNumberGenerator]::Create()
# $jwtRandom.GetBytes($jwtBytes); $jwtRandom.Dispose(); [Convert]::ToBase64String($jwtBytes) | Set-Clipboard
ORDA_AUTH_JWT_SECRET_BASE64=
ORDA_AUTH_JWT_ACCESS_TOKEN_SECONDS=3600

# Comma-separated browser origins, without paths or trailing slashes.
ORDA_AUTH_CORS_ALLOWED_ORIGINS=http://localhost:5173
